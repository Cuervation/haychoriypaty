#!/usr/bin/env bash
# Hook opt-in (no se instala solo). Activar en este clon con:
#   git config core.hooksPath tools/git/hooks
# Protege a humanos, Claude y Codex por igual porque actúa sobre git, no sobre la herramienta:
#   - bloquea borrar ramas remotas, force push (no fast-forward) y push directo a main;
#   - valida solo los commits nuevos (check-repo --range), sin Unity.
# Excepciones conscientes y puntuales: HCYP_ALLOW_DANGEROUS_PUSH=1 / HCYP_ALLOW_MAIN_PUSH=1.
remote="$1"
root=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ -n "${local_ref:-}" ] || continue
  case "$remote_ref" in refs/heads/*) ;; *) continue ;; esac   # tags y otros refs: sin validación
  name=${remote_ref#refs/heads/}
  if [ "$local_sha" = "$zero" ]; then
    if [ "${HCYP_ALLOW_DANGEROUS_PUSH:-0}" != "1" ]; then
      echo "pre-push: bloqueado borrar la rama remota '$name' ($remote). Requiere aprobación explícita." >&2; status=1
    fi
    continue
  fi
  if [ "$name" = "main" ] && [ "${HCYP_ALLOW_MAIN_PUSH:-0}" != "1" ]; then
    echo "pre-push: 'main' se integra por Pull Request (squash/merge en GitHub), no con push directo." >&2; status=1; continue
  fi
  if [ "$remote_sha" != "$zero" ]; then
    if ! git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      echo "pre-push: el remoto tiene commits que no están en este clon ('$name'). Hacé git fetch y revisá antes de publicar." >&2; status=1; continue
    fi
    if ! git merge-base --is-ancestor "$remote_sha" "$local_sha"; then
      if [ "${HCYP_ALLOW_DANGEROUS_PUSH:-0}" != "1" ]; then
        echo "pre-push: '$name' no es fast-forward (reescribe historial remoto). Requiere aprobación explícita." >&2; status=1; continue
      fi
    fi
    base="$remote_sha"
  else
    # Rama nueva: validar contra la rama predeterminada remota, si se conoce.
    base=$(git merge-base "$local_sha" "refs/remotes/$remote/HEAD" 2>/dev/null || true)
  fi
  echo "pre-push: validando '$name'…"
  if [ -n "$base" ]; then bash "$root/tools/git/check-repo.sh" --range "$base..$local_sha" </dev/null || status=1
  else bash "$root/tools/git/check-repo.sh" --tree "$local_sha" </dev/null || status=1; fi
done
exit $status
